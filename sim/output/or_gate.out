#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x592f06f56640 .scope module, "tb_or_gate" "tb_or_gate" 2 3;
 .timescale -9 -12;
v0x592f06f674c0_0 .var "a", 0 0;
v0x592f06f67590_0 .var "b", 0 0;
v0x592f06f67660_0 .net "y", 0 0, L_0x592f06f67760;  1 drivers
S_0x592f06f567d0 .scope module, "dut" "or_gate" 2 7, 3 1 0, S_0x592f06f56640;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x592f06f67760 .functor OR 1, v0x592f06f674c0_0, v0x592f06f67590_0, C4<0>, C4<0>;
v0x592f06f42f00_0 .net "a", 0 0, v0x592f06f674c0_0;  1 drivers
v0x592f06f672e0_0 .net "b", 0 0, v0x592f06f67590_0;  1 drivers
v0x592f06f673a0_0 .net "y", 0 0, L_0x592f06f67760;  alias, 1 drivers
    .scope S_0x592f06f56640;
T_0 ;
    %vpi_call 2 10 "$dumpfile", "sim/output/or_gate.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x592f06f56640 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x592f06f674c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x592f06f67590_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 14 "$display", "a=%b b=%b -> y=%b", v0x592f06f674c0_0, v0x592f06f67590_0, v0x592f06f67660_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x592f06f674c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x592f06f67590_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 17 "$display", "a=%b b=%b -> y=%b", v0x592f06f674c0_0, v0x592f06f67590_0, v0x592f06f67660_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x592f06f674c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x592f06f67590_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 20 "$display", "a=%b b=%b -> y=%b", v0x592f06f674c0_0, v0x592f06f67590_0, v0x592f06f67660_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x592f06f674c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x592f06f67590_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 23 "$display", "a=%b b=%b -> y=%b", v0x592f06f674c0_0, v0x592f06f67590_0, v0x592f06f67660_0 {0 0 0};
    %vpi_call 2 24 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "sim/tb_or_gate.v";
    "rtl/or_gate.v";
